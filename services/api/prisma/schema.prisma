datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(uuid())
  nickname           String?              @unique
  email              String?              @unique
  displayName        String?
  passwordHash       String?
  tokenVersion       Int                  @default(0)
  provider           String?              @default("email")
  avatarUrl          String?              // 대표 원형 아이콘 URL
  bio                String?              @db.VarChar(200)
  pointBalance       Int                  @default(0) // 실제 충전/보유 온(ON) 포인트
  callRatePerMinute  Int?                 // 호스트 자율 단가 (null 시 시스템 기본값)
  status             String               @default("active")
  role               String               @default("user")
  photos             UserPhoto[]
  hostedCalls        PrivateCallSession[] @relation("HostSessions")
  guestCalls         PrivateCallSession[] @relation("GuestSessions")
  giftTransactions   GiftTransaction[]
  aiDecisions        AiDecisionQueue[]
  marketProducts     MarketProduct[]
  buyerOrders        EscrowOrder[]        @relation("BuyerOrders")
  sellerOrders       EscrowOrder[]        @relation("SellerOrders")
  sudaPosts          SudaPost[]
  sellerSettlements  SellerSettlement[]
  liveRooms          LiveRoom[]
  adminProfile       AdminProfile?
  auditLogs          AuditLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model AdminProfile {
  userId           String          @id
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             AdminTeamRole   @default(MANAGER)
  status           AdminTeamStatus @default(ACTIVE)
  permissions      String[]
  twoFactorEnabled Boolean         @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model AdminFeatureFlag {
  id          String   @id
  name        String   @unique
  description String?
  environment String   @default("production")
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminIntegrationSetting {
  id             String   @id
  label          String
  placeholder    String?
  encryptedValue String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AdminSettingsState {
  id        String   @id @default("default")
  auditMemo String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  target    String
  action    String
  context   Json?
  notes     String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

model AdminApprovalRequest {
  id             String              @id @default(cuid())
  action         String
  target         String
  reason         String?
  requestedById  String
  decidedById    String?
  status         AdminApprovalStatus @default(PENDING)
  decisionReason String?
  context        Json?
  metadata       Json?
  idempotencyKey String?
  expiresAt      DateTime?
  decidedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([requestedById])
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdminTeamRole {
  SUPER_ADMIN
  MANAGER
  MODERATOR
  SUPPORT
  EDITOR
  VIEWER
}

enum AdminTeamStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  WARNING
  SUSPENDED
  BANNED
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

model UserPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, sortOrder])
}

model SystemSetting {
  key         String   @id // "DEFAULT_CALL_RATE", "PLATFORM_FEE_PERCENT", "SNAPSHOT_INTERVAL_SEC"
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model PrivateCallSession {
  id             String        @id @default(uuid())
  channelId      String        @unique
  hostId         String
  guestId        String
  host           User          @relation("HostSessions", fields: [hostId], references: [id])
  guest          User          @relation("GuestSessions", fields: [guestId], references: [id])
  ratePerMinute  Int
  billedMinutes  Int           @default(0)
  totalDeducted  Int           @default(0)
  platformFee    Int           @default(0)
  creatorRevenue Int           @default(0)
  status         CallStatus    @default(RINGING)
  startedAt      DateTime?
  endedAt        DateTime?
  endReason      String?
  createdAt      DateTime      @default(now())

  @@index([hostId, guestId])
}

enum CallStatus {
  RINGING
  CONNECTED
  TERMINATED
}

model GiftTransaction {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  channelId   String?
  giftName    String
  points      Int
  effectTier  Int      // 1, 2, 3
  createdAt   DateTime @default(now())
  sender      User     @relation(fields: [senderId], references: [id])

  @@index([channelId, createdAt])
}

model StreamSnapshotAudit {
  id            String   @id @default(uuid())
  channelId     String
  hostId        String
  snapshotUrl   String
  riskScore     Int      // 0 ~ 100
  isViolated    Boolean  @default(false)
  violationTags Json?
  capturedAt    DateTime @default(now())

  @@index([channelId, isViolated])
  @@index([capturedAt])
}

model AiDecisionQueue {
  id                Int              @id @default(autoincrement())
  domain            AiTargetDomain
  targetId          String           
  targetUserId      String?
  targetUser        User?            @relation(fields: [targetUserId], references: [id])
  riskScore         Int              
  summary           String           
  evidence          String?          @db.Text
  snapshotUrls      Json?            // 아고라 실시간 채증 이미지 URL 목록
  directorReview    String?          @db.Text // 총괄 팀장 AI의 검토 소견
  collaborationLog  Json?            // 6인 AI 직원 간 협업/소통 타임라인 로그
  recommendedAction String           // "TERMINATE_CALL", "SUSPEND_30D", "BAN_USER", "DISMISS"
  rationale         String           @db.Text
  status            AiDecisionStatus @default(PENDING_APPROVAL)
  reviewedBy        String?          
  reviewedAt        DateTime?
  adminMemo         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([domain, status])
}

enum AiDecisionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  MODIFIED
}

enum AiTargetDomain {
  LIVE_STREAM_SAFETY
  PRIVATE_CALL_DISPUTE
  REPORT_SAFETY
  CREATOR_SETTLEMENT
  CONTENT_MODERATION
}

model LegalDocument {
  slug      String   @id
  title     String
  content   String   @db.Text
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LegalDocumentVersion {
  id           String   @id @default(cuid())
  documentSlug String
  version      Int
  title        String
  content      String   @db.Text
  memo         String?
  updatedBy    String?
  createdAt    DateTime @default(now())

  @@index([documentSlug, version])
}

// ==========================================
// 1. 마켓 & 공동구매 (C2C & B2C)
// ==========================================
model MarketProduct {
  id              String             @id @default(uuid())
  sellerId        String
  seller          User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type            MarketProductType  @default(C2C_USED) // C2C_USED(중고거래) | B2C_GROUP(공동구매)
  title           String             @db.VarChar(100)
  description     String             @db.Text
  category        String             // "DIGITAL", "FURNITURE", "FOOD_GROUP", "FASHION", etc.
  price           Int                // ON 포인트 가격 (1 ON = 1 KRW)
  originalPrice   Int?               // B2C 공구 시 정가
  targetQuantity  Int                @default(1) // 공구 목표 인원
  currentQuantity Int                @default(0) // 현재 참여 인원
  images          Json               // 사진 URL 배열 (최대 10장)
  status          ProductStatus      @default(ACTIVE) // ACTIVE, RESERVED, COMPLETED, CANCELLED
  locationName    String?            // 희망 거래 동네/장소명 (예: 역삼역 3번출구)
  latitude        Float?
  longitude       Float?
  escrowOrders    EscrowOrder[]
  livePins        LiveCommercePin[]
  livePinnedIn    LiveRoom[]         @relation("PinnedProduct")
  liveLinks       LiveProductLink[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([type, status, createdAt])
  @@index([sellerId])
}

enum MarketProductType {
  C2C_USED
  B2C_GROUP
}

enum ProductStatus {
  ACTIVE
  RESERVED
  COMPLETED
  CANCELLED
}

// ==========================================
// 2. ON 포인트 에스크로 안전결제 주문
// ==========================================
model EscrowOrder {
  id              String             @id @default(uuid())
  orderNumber     String             @unique // 주문 고유번호 (예: ORD-202610-XXXX)
  productId       String
  product         MarketProduct      @relation(fields: [productId], references: [id])
  buyerId         String
  buyer           User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId        String
  seller          User               @relation("SellerOrders", fields: [sellerId], references: [id])
  liveId          String?            // D LIVE 방송 중 구매 시 해당 방송 ID
  amount          Int                // 총 결제 원화 금액 (KRW, 1:1)
  feeAmount       Int?               // 안전결제 수수료 (KRW)
  platformFeeRate Float              @default(0.035) // 안전결제 수수료율 (기본 3.5%)
  platformFee     Int                @default(0) // 플랫폼 수수료 원화
  sellerPayout    Int                @default(0) // 판매자 정산 예정액 (amount - platformFee)
  status          EscrowStatus       @default(PAYMENT_PENDING)
  pgProvider      String?            @default("TOSS_PAYMENTS") // TOSS_PAYMENTS, PORTONE 등
  pgPaymentKey    String?            // PG 거래 고유 승인 키 (paymentKey)
  trackingNumber  String?            // 택배 송장번호 (직거래 시 NULL)
  chatRoomId      String?            // 연결된 거래 톡방 ID
  disputeReason   String?
  settlement      SellerSettlement?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([pgPaymentKey])
}

enum EscrowStatus {
  PAYMENT_PENDING // PG 결제 대기
  PAID_ESCROW     // PG 결제 완료 및 에스크로 안전 예치
  ESCROW_HOLD     // 기존 상태 호환
  SHIPPED         // 발송 및 배송 중
  COMPLETED       // 구매 확정 (판매자 정산 대기열 등록)
  CONFIRMED       // 기존 상태 호환
  CANCELLED       // 결제 취소
  DISPUTED        // 분쟁 접수 (관리자 중재 대기)
  REFUNDED        // 환불 완료
}

model SellerSettlement {
  id            String                 @id @default(uuid())
  sellerId      String
  seller        User                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId       String                 @unique
  order         EscrowOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalAmount   Int                    // 총 결제액 (KRW)
  netAmount     Int                    // 판매자 실수령 정산금 (KRW)
  bankName      String?                // 정산 은행
  accountNumber String?                // 정산 계좌번호
  accountHolder String?                // 예금주명
  status        SellerSettlementStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([sellerId, status])
  @@index([status])
}

enum SellerSettlementStatus {
  PENDING
  PAID
  CANCELLED
}

// ==========================================
// 3. 실시간 1줄 동네 수다 (SUDA)
// ==========================================
model SudaPost {
  id              String             @id @default(uuid())
  authorId        String
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content         String             @db.VarChar(200) // 1줄 수다 본문
  neighborhood    String             // 작성자 동네 (예: 역삼동)
  latitude        Float?
  longitude       Float?
  likesCount      Int                @default(0)
  repliesCount    Int                @default(0)
  createdAt       DateTime           @default(now())

  @@index([neighborhood, createdAt])
  @@index([createdAt])
}

// ==========================================
// 4. D LIVE 라이브 방송 및 커머스 핀 연동
// ==========================================
model LiveRoom {
  id               String            @id @default(uuid())
  title            String
  category         String            @default("talk")
  entryFee         Int               @default(0)
  hostId           String
  host             User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  status           String            @default("ACTIVE") // ACTIVE, ENDED
  hasCommerce      Boolean           @default(false)    // 라이브 커머스 상품 연결 여부
  pinnedProductId  String?           // 현재 화면에 고정된 핀 상품 ID
  pinnedProduct    MarketProduct?    @relation("PinnedProduct", fields: [pinnedProductId], references: [id])
  coverUri         String?
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  productLinks     LiveProductLink[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, hasCommerce])
  @@index([hostId])
}

model LiveProductLink {
  id         String        @id @default(uuid())
  roomId     String
  room       LiveRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  productId  String
  product    MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  isPinned   Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@unique([roomId, productId])
  @@index([roomId])
}

model LiveCommercePin {
  id              String             @id @default(uuid())
  channelId       String             // Agora 라이브 채널 ID
  productId       String
  product         MarketProduct      @relation(fields: [productId], references: [id])
  isPinned        Boolean            @default(true)
  pinnedAt        DateTime           @default(now())
  unpinnedAt      DateTime?

  @@index([channelId, isPinned])
}
