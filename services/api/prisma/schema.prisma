datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(uuid())
  nickname           String?              @unique
  email              String?              @unique
  displayName        String?
  passwordHash       String?
  tokenVersion       Int                  @default(0)
  provider           String?              @default("email")
  avatarUrl          String?              // 대표 원형 아이콘 URL
  bio                String?              @db.VarChar(200)
  pointBalance       Int                  @default(0) // 실제 충전/보유 온(ON) 포인트
  callRatePerMinute  Int?                 // 호스트 자율 단가 (null 시 시스템 기본값)
  status             String               @default("active")
  role               String               @default("user")
  photos             UserPhoto[]
  hostedCalls        PrivateCallSession[] @relation("HostSessions")
  guestCalls         PrivateCallSession[] @relation("GuestSessions")
  giftTransactions   GiftTransaction[]
  aiDecisions        AiDecisionQueue[]
  adminProfile       AdminProfile?
  auditLogs          AuditLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model AdminProfile {
  userId           String      @id
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String      @default("MANAGER")
  status           String      @default("ACTIVE")
  permissions      String[]
  twoFactorEnabled Boolean     @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model AdminFeatureFlag {
  id          String   @id
  name        String   @unique
  description String?
  environment String   @default("production")
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminIntegrationSetting {
  id             String   @id
  label          String
  placeholder    String?
  encryptedValue String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AdminSettingsState {
  id        String   @id @default("default")
  auditMemo String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  target    String
  action    String
  context   Json?
  notes     String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

enum UserStatus {
  ACTIVE
  WARNING
  SUSPENDED
  BANNED
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

model UserPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, sortOrder])
}

model SystemSetting {
  key         String   @id // "DEFAULT_CALL_RATE", "PLATFORM_FEE_PERCENT", "SNAPSHOT_INTERVAL_SEC"
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model PrivateCallSession {
  id             String        @id @default(uuid())
  channelId      String        @unique
  hostId         String
  guestId        String
  host           User          @relation("HostSessions", fields: [hostId], references: [id])
  guest          User          @relation("GuestSessions", fields: [guestId], references: [id])
  ratePerMinute  Int
  billedMinutes  Int           @default(0)
  totalDeducted  Int           @default(0)
  platformFee    Int           @default(0)
  creatorRevenue Int           @default(0)
  status         CallStatus    @default(RINGING)
  startedAt      DateTime?
  endedAt        DateTime?
  endReason      String?
  createdAt      DateTime      @default(now())

  @@index([hostId, guestId])
}

enum CallStatus {
  RINGING
  CONNECTED
  TERMINATED
}

model GiftTransaction {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  channelId   String?
  giftName    String
  points      Int
  effectTier  Int      // 1, 2, 3
  createdAt   DateTime @default(now())
  sender      User     @relation(fields: [senderId], references: [id])

  @@index([channelId, createdAt])
}

model StreamSnapshotAudit {
  id            String   @id @default(uuid())
  channelId     String
  hostId        String
  snapshotUrl   String
  riskScore     Int      // 0 ~ 100
  isViolated    Boolean  @default(false)
  violationTags Json?
  capturedAt    DateTime @default(now())

  @@index([channelId, isViolated])
  @@index([capturedAt])
}

model AiDecisionQueue {
  id                Int              @id @default(autoincrement())
  domain            AiTargetDomain
  targetId          String           
  targetUserId      String?
  targetUser        User?            @relation(fields: [targetUserId], references: [id])
  riskScore         Int              
  summary           String           
  evidence          String?          @db.Text
  snapshotUrls      Json?            // 아고라 실시간 채증 이미지 URL 목록
  directorReview    String?          @db.Text // 총괄 팀장 AI의 검토 소견
  collaborationLog  Json?            // 6인 AI 직원 간 협업/소통 타임라인 로그
  recommendedAction String           // "TERMINATE_CALL", "SUSPEND_30D", "BAN_USER", "DISMISS"
  rationale         String           @db.Text
  status            AiDecisionStatus @default(PENDING_APPROVAL)
  reviewedBy        String?          
  reviewedAt        DateTime?
  adminMemo         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([domain, status])
}

enum AiDecisionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  MODIFIED
}

enum AiTargetDomain {
  LIVE_STREAM_SAFETY
  PRIVATE_CALL_DISPUTE
  REPORT_SAFETY
  CREATOR_SETTLEMENT
  CONTENT_MODERATION
}
