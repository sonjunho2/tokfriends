// services/api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // 앱 런타임: Neon "pooled" 연결
  directUrl = env("DIRECT_URL")     // 마이그레이션: Neon "direct" 연결
}

model User {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  phoneHash      String?  @unique
  email          String?  @unique
  provider       String
  dob            DateTime?
  gender         String?
  region1        String?
  region2        String?
  lang           String?

  trustScore     Int      @default(50)
  status         String   @default("active")
  role           String   @default("user")
  passwordHash   String?
  tokenVersion   Int      @default(0)
  displayName    String?
  pointsBalance  Int      @default(0)

  profile        Profile?
  devices        Device[]
  photos         Photo[]
  friendshipsA   Friendship[] @relation("A")
  friendshipsB   Friendship[] @relation("B")
  chatsA         Chat[]       @relation("A")
  chatsB         Chat[]       @relation("B")
  messages       Message[]
  reportsByMe    Report[]     @relation("reports_by")
  reportsToMe    Report[]     @relation("reports_to")
  blocksByMe     Block[]      @relation("blocks_by")
  blocksToMe     Block[]      @relation("blocks_to")
  posts          Post[]
  subscriptions  Subscription[]
  events         AnalyticsEvent[]
  auditLogs      AuditLog[]   @relation("AuditActor")
  refundRequests RefundRequest[]
  pointPurchases PointPurchase[]
  phoneVerifications PhoneVerification[]
  adminProfile       AdminProfile?
  ownerBridge           Owner?           @relation("LegacyOwnerUser")
  activityAccountBridge ActivityAccount? @relation("LegacyActivityUser")
  adminApprovalRequests AdminApprovalRequest[] @relation("AdminApprovalRequester")
  adminApprovalDecisions AdminApprovalRequest[] @relation("AdminApprovalDecider")
}

model Owner {
  id               String            @id @default(cuid())
  legacyUserId     String?           @unique
  legacyUser       User?             @relation("LegacyOwnerUser", fields: [legacyUserId], references: [id], onDelete: SetNull)
  status           String            @default("active")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activityAccounts ActivityAccount[]
}

model ActivityAccount {
  id           String   @id @default(cuid())
  ownerId      String
  owner        Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  legacyUserId String?  @unique
  legacyUser   User?    @relation("LegacyActivityUser", fields: [legacyUserId], references: [id], onDelete: SetNull)
  handle       String?  @unique
  displayName  String?
  status       String   @default("active")
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wallet       Wallet?
  followsSent           Follow[]       @relation("FollowFollower")
  followsReceived       Follow[]       @relation("FollowFollowing")
  interestsSent         Interest[]     @relation("InterestSender")
  interestsReceived     Interest[]     @relation("InterestTarget")
  profileVisitsMade     ProfileVisit[] @relation("ProfileVisitVisitor")
  profileVisitsReceived ProfileVisit[] @relation("ProfileVisitVisited")
  chatsAsAccountA       Chat[]         @relation("ChatAccountA")
  chatsAsAccountB       Chat[]         @relation("ChatAccountB")
  chatMessagesSent      Message[]      @relation("MessageSenderAccount")

  @@index([ownerId])
  @@index([ownerId, isPrimary])
}

model Follow {
  id                 String          @id @default(cuid())
  followerAccountId  String
  followingAccountId String
  followerAccount    ActivityAccount @relation("FollowFollower", fields: [followerAccountId], references: [id], onDelete: Cascade)
  followingAccount   ActivityAccount @relation("FollowFollowing", fields: [followingAccountId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())

  @@unique([followerAccountId, followingAccountId])
  @@index([followerAccountId, createdAt])
  @@index([followingAccountId, createdAt])
}

model Interest {
  id              String          @id @default(cuid())
  senderAccountId String
  targetAccountId String
  senderAccount   ActivityAccount @relation("InterestSender", fields: [senderAccountId], references: [id], onDelete: Cascade)
  targetAccount   ActivityAccount @relation("InterestTarget", fields: [targetAccountId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())

  @@unique([senderAccountId, targetAccountId])
  @@index([senderAccountId, createdAt])
  @@index([targetAccountId, createdAt])
}

model ProfileVisit {
  id               String          @id @default(cuid())
  visitorAccountId String
  visitedAccountId String
  visitorAccount   ActivityAccount @relation("ProfileVisitVisitor", fields: [visitorAccountId], references: [id], onDelete: Cascade)
  visitedAccount   ActivityAccount @relation("ProfileVisitVisited", fields: [visitedAccountId], references: [id], onDelete: Cascade)
  visitedAt        DateTime        @default(now())

  @@index([visitorAccountId, visitedAt])
  @@index([visitedAccountId, visitedAt])
}

model Wallet {
  id                String   @id @default(cuid())
  activityAccountId String   @unique
  activityAccount   ActivityAccount @relation(fields: [activityAccountId], references: [id], onDelete: Restrict)
  spendableBalance  Int      @default(0)
  redeemableBalance Int      @default(0)
  pendingEarnings   Int      @default(0)
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ledgerEntries     WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id                String   @id @default(cuid())
  walletId          String
  wallet            Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  kind              String
  source            String
  deltaSpendable    Int      @default(0)
  deltaRedeemable   Int      @default(0)
  deltaPending      Int      @default(0)
  spendableAfter    Int
  redeemableAfter   Int
  pendingAfter      Int
  idempotencyKey    String   @unique
  referenceType     String?
  referenceId       String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

model Profile {
  userId     String  @id
  user       User    @relation(fields: [userId], references: [id])
  nickname   String
  bio        String?
  headline   String?
  avatarUri  String?
  interests  String[]
  badges     String[]
  lastSeenAt DateTime?
  visibility Json?
}

model PhoneVerification {
  id          String   @id @default(cuid())
  phone       String
  countryCode String
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  completedAt DateTime?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([phone])
}

model PointPurchase {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  productId     String
  transactionId String
  platform      String
  receipt       String?
  points        Int
  status        String   @default("completed")
  createdAt     DateTime @default(now())

  @@unique([platform, transactionId])
}

model Photo {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  url         String
  visibility  String   @default("public")
  isSensitive Boolean  @default(false)
  aiNudity    Float    @default(0)
  createdAt   DateTime @default(now())
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  requester   User     @relation("A", fields: [requesterId], references: [id])
  addressee   User     @relation("B", fields: [addresseeId], references: [id])
  status      String   @default("requested")
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
}

model Chat {
  id            String           @id @default(cuid())
  userAId       String
  userBId       String
  userA         User             @relation("A", fields: [userAId], references: [id])
  userB         User             @relation("B", fields: [userBId], references: [id])
  accountAId    String?
  accountBId    String?
  accountA      ActivityAccount? @relation("ChatAccountA", fields: [accountAId], references: [id], onDelete: SetNull)
  accountB      ActivityAccount? @relation("ChatAccountB", fields: [accountBId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime?
  messages      Message[]

  @@unique([accountAId, accountBId])
  @@index([accountAId, lastMessageAt])
  @@index([accountBId, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  chatId            String
  chat              Chat             @relation(fields: [chatId], references: [id])
  senderId          String
  sender            User             @relation(fields: [senderId], references: [id])
  senderAccountId   String?
  clientMessageId   String?          @db.VarChar(128)
  senderAccount     ActivityAccount? @relation("MessageSenderAccount", fields: [senderAccountId], references: [id], onDelete: SetNull)
  type              String           @default("text")
  content           String
  translatedContent String?
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  isFlagged         Boolean          @default(false)

  @@unique([senderAccountId, clientMessageId])
  @@index([senderAccountId, createdAt])
  @@index([chatId, createdAt, id])
  @@index([chatId, readAt])
}

model Topic {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  topic   Topic    @relation(fields: [topicId], references: [id])
  reports Report[]

  @@index([topicId, createdAt])
}

model Report {
  id          Int     @id @default(autoincrement())

  /// 신고자 (User.reportsByMe 반대편)
  reporter    User    @relation("reports_by", fields: [reporterId], references: [id])
  reporterId  String  // User.id가 String(CUID)에 맞춤

  /// 피신고자 (선택)
  reported    User?   @relation("reports_to", fields: [reportedId], references: [id], onDelete: SetNull)
  reportedId  String?

  /// 게시글 신고 (선택)
  post        Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  postId      String? // Post.id가 String이면 String

  reason      String
  status      ReportStatus @default(PENDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reporterId])
  @@index([reportedId])
  @@index([postId])
}

model Block {
  id             String   @id @default(cuid())
  userId         String
  blockedUserId  String
  createdAt      DateTime @default(now())

  user        User @relation("blocks_by", fields: [userId], references: [id])
  blockedUser User @relation("blocks_to", fields: [blockedUserId], references: [id])

  @@unique([userId, blockedUserId])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  platform  String
  token     String   @unique
  locale    String?
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  platform  String
  productId String
  status    String
  startedAt DateTime
  expiresAt DateTime?
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  event     String
  props     Json
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  target    String
  action    String
  notes     String?
  reason    String?
  context   Json?
  metadata  Json?
  createdAt DateTime @default(now())
}

model RefundRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  platform  String
  productId String
  receiptId String
  reason    String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  decidedAt DateTime?
}
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  isActive  Boolean  @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
}
model BannedWord {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())
}

enum AdminTeamRole {
  SUPER_ADMIN
  MANAGER
  MODERATOR
  SUPPORT
  EDITOR
  VIEWER
}

enum AdminTeamStatus {
  ACTIVE
  SUSPENDED
}

model AdminProfile {
  userId           String          @id
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             AdminTeamRole   @default(MANAGER)
  status           AdminTeamStatus @default(ACTIVE)
  permissions      String[]        @default([])
  twoFactorEnabled Boolean         @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([role])
  @@index([status])
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AdminApprovalRequest {
  id              String              @id @default(cuid())
  action          String
  target          String
  reason          String
  context         Json?
  metadata        Json?
  status          AdminApprovalStatus @default(PENDING)
  idempotencyKey  String?             @unique
  requestedById   String
  requestedBy     User                @relation("AdminApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById     String?
  decidedBy       User?               @relation("AdminApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decisionReason  String?
  expiresAt       DateTime?
  decidedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([requestedById, status])
  @@index([target, action])
}

model AdminFeatureFlag {
  id          String   @id
  name        String   @unique
  description String?
  environment String
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminIntegrationSetting {
  id             String   @id
  label          String
  placeholder    String?
  encryptedValue String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AdminSettingsState {
  id        String   @id @default("default")
  auditMemo String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LegalDocument {
  slug      String   @id
  title     String
  content   String   @db.Text
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions LegalDocumentVersion[]
}

model LegalDocumentVersion {
  id           String        @id @default(cuid())
  documentSlug String
  document     LegalDocument @relation(fields: [documentSlug], references: [slug], onDelete: Cascade)
  version      Int
  title        String
  content      String        @db.Text
  updatedBy    String?
  memo         String?       @db.Text
  createdAt    DateTime      @default(now())

  @@unique([documentSlug, version])
  @@index([documentSlug, createdAt])
}
enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}
